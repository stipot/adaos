{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "webio": {
    "receivers": {
      "ai_event_analysis.results": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": [
          {
            "id": "pending",
            "title": "Проверка ещё не запускалась",
            "description": "Откройте приложение или запустите демо-проверку, чтобы увидеть результат."
          }
        ],
        "budget": {
          "maxPayloadBytes": 12288,
          "maxPublishHz": 0.5,
          "maxSnapshotHz": 0.5,
          "maxItems": 4
        },
        "guardVisibility": {
          "degradedState": "Сохранить последний результат и запросить ручное обновление.",
          "log": "service.ai_event_analysis_skill.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.ai_event_analysis.results"
        },
        "route": {
          "kind": "stream",
          "surface": "modal:ai_event_analysis",
          "owner": "skill:ai_event_analysis_skill",
          "firstPaint": "static benchmark defaults",
          "recovery": "snapshot requested on stream subscribe",
          "updateSource": [
            "webio.stream.snapshot.requested",
            "ai_event_analysis.evaluate_requested"
          ]
        }
      }
    }
  },
  "apps": [
    {
      "id": "ai_event_analysis_app",
      "title": "Интеллектуальный анализ событий",
      "icon": "analytics-outline",
      "launchModal": "ai_event_analysis_modal"
    }
  ],
  "widgets": [
    {
      "id": "ai_event_analysis_widget",
      "title": "Интеллектуальный анализ событий",
      "type": "visual.metricTile",
      "icon": "analytics-outline",
      "dataSource": {
        "kind": "y",
        "path": "data/ai_event_analysis/summary"
      },
      "actions": [
        {
          "on": "click:open",
          "type": "openModal",
          "params": {
            "modalId": "ai_event_analysis_modal"
          }
        },
        {
          "on": "click:run_demo",
          "type": "callSkill",
          "target": "ai_event_analysis_skill.run_demo_evaluation",
          "params": {
            "webspace_id": "$runtime.webspace_id"
          }
        }
      ]
    }
  ],
  "registry": {
    "modals": {
      "ai_event_analysis_modal": {
        "title": "Интеллектуальный анализ событий",
        "schema": {
          "id": "ai_event_analysis_modal",
          "initialState": {
            "aiEventAnalysisTab": "overview"
          },
          "layout": {
            "type": "split",
            "pattern": "split",
            "areas": [
              {
                "id": "main",
                "role": "main"
              },
              {
                "id": "right",
                "role": "aux"
              },
              {
                "id": "bottom",
                "role": "footer"
              }
            ]
          },
          "widgets": [
            {
              "id": "ai-event-analysis-summary",
              "type": "visual.metricTile",
              "area": "main",
              "title": "Текущая оценка",
              "dataSource": {
                "kind": "y",
                "path": "data/ai_event_analysis/summary"
              },
              "actions": [
                {
                  "on": "click:run_demo",
                  "type": "callSkill",
                  "target": "ai_event_analysis_skill.run_demo_evaluation",
                  "params": {
                    "webspace_id": "$runtime.webspace_id"
                  }
                }
              ]
            },
            {
              "id": "ai-event-analysis-tabs",
              "type": "input.commandBar",
              "area": "main",
              "inputs": {
                "size": "small",
                "selectedStateKey": "aiEventAnalysisTab",
                "buttons": [
                  {
                    "id": "overview",
                    "label": "Обзор"
                  },
                  {
                    "id": "dataset",
                    "label": "Данные"
                  },
                  {
                    "id": "windows",
                    "label": "Окна событий"
                  },
                  {
                    "id": "metrics",
                    "label": "Метрики"
                  },
                  {
                    "id": "experiments",
                    "label": "Эксперименты"
                  },
                  {
                    "id": "agent",
                    "label": "Агент"
                  },
                  {
                    "id": "subscriptions",
                    "label": "Подписки"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click",
                  "type": "updateState",
                  "params": {
                    "aiEventAnalysisTab": "$event.id"
                  }
                }
              ]
            },
            {
              "id": "ai-event-analysis-task",
              "type": "ui.list",
              "area": "main",
              "title": "Задача",
              "visibleIf": "$state.aiEventAnalysisTab === 'overview'",
              "dataSource": {
                "kind": "y",
                "path": "data/ai_event_analysis/task"
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "description",
                "showDetails": false,
                "itemAccordion": false,
                "emptyText": "Описание задачи отсутствует"
              }
            },
            {
              "id": "ai-event-analysis-dataset",
              "type": "ui.table",
              "area": "main",
              "title": "Состав данных",
              "visibleIf": "$state.aiEventAnalysisTab === 'dataset'",
              "dataSource": {
                "kind": "y",
                "path": "data/ai_event_analysis/dataset"
              },
              "inputs": {
                "emptyText": "Описание данных отсутствует",
                "columns": [
                  {
                    "key": "name",
                    "label": "Элемент"
                  },
                  {
                    "key": "current",
                    "label": "Текущее",
                    "width": "110px",
                    "mono": true
                  },
                  {
                    "key": "target",
                    "label": "Цель",
                    "width": "140px"
                  },
                  {
                    "key": "notes",
                    "label": "Примечания"
                  }
                ]
              }
            },
            {
              "id": "ai-event-analysis-metrics",
              "type": "ui.table",
              "area": "main",
              "title": "Метрики качества",
              "visibleIf": "$state.aiEventAnalysisTab === 'metrics'",
              "dataSource": {
                "kind": "y",
                "path": "data/ai_event_analysis/metrics"
              },
              "inputs": {
                "emptyText": "Метрики отсутствуют",
                "columns": [
                  {
                    "key": "metric",
                    "label": "Метрика"
                  },
                  {
                    "key": "value",
                    "label": "Значение",
                    "width": "100px",
                    "mono": true
                  },
                  {
                    "key": "target",
                    "label": "Цель",
                    "width": "140px"
                  },
                  {
                    "key": "status",
                    "label": "Состояние",
                    "width": "100px"
                  }
                ]
              }
            },
            {
              "id": "ai-event-analysis-windows",
              "type": "ui.table",
              "area": "main",
              "title": "Окна событий",
              "visibleIf": "$state.aiEventAnalysisTab === 'windows'",
              "dataSource": {
                "kind": "y",
                "path": "data/ai_event_analysis/windows"
              },
              "inputs": {
                "emptyText": "Окна событий ещё не построены",
                "columns": [
                  {
                    "key": "window_id",
                    "label": "Окно"
                  },
                  {
                    "key": "events",
                    "label": "События",
                    "width": "80px",
                    "mono": true
                  },
                  {
                    "key": "errors",
                    "label": "Ошибки",
                    "width": "80px",
                    "mono": true
                  },
                  {
                    "key": "prediction",
                    "label": "Прогноз правила",
                    "width": "190px"
                  },
                  {
                    "key": "severity",
                    "label": "Важность",
                    "width": "100px"
                  },
                  {
                    "key": "confidence",
                    "label": "Уверенность",
                    "width": "110px",
                    "mono": true
                  }
                ]
              }
            },
            {
              "id": "ai-event-analysis-per-class",
              "type": "ui.table",
              "area": "main",
              "title": "Оценка по классам",
              "visibleIf": "$state.aiEventAnalysisTab === 'metrics'",
              "dataSource": {
                "kind": "y",
                "path": "data/ai_event_analysis/per_class"
              },
              "inputs": {
                "emptyText": "Метрики по классам отсутствуют",
                "columns": [
                  {
                    "key": "class",
                    "label": "Класс"
                  },
                  {
                    "key": "precision",
                    "label": "Точность",
                    "width": "110px",
                    "mono": true
                  },
                  {
                    "key": "recall",
                    "label": "Полнота",
                    "width": "100px",
                    "mono": true
                  },
                  {
                    "key": "f1",
                    "label": "F1",
                    "width": "80px",
                    "mono": true
                  },
                  {
                    "key": "support",
                    "label": "Примеры",
                    "width": "90px",
                    "mono": true
                  }
                ]
              }
            },
            {
              "id": "ai-event-analysis-experiments",
              "type": "ui.table",
              "area": "main",
              "title": "План экспериментов",
              "visibleIf": "$state.aiEventAnalysisTab === 'experiments'",
              "dataSource": {
                "kind": "y",
                "path": "data/ai_event_analysis/experiments"
              },
              "inputs": {
                "emptyText": "План экспериментов отсутствует",
                "columns": [
                  {
                    "key": "model",
                    "label": "Модель"
                  },
                  {
                    "key": "status",
                    "label": "Статус",
                    "width": "130px"
                  },
                  {
                    "key": "macro_f1",
                    "label": "Macro-F1",
                    "width": "100px",
                    "mono": true
                  },
                  {
                    "key": "next_step",
                    "label": "Следующий шаг"
                  }
                ]
              }
            },
            {
              "id": "ai-event-analysis-agent-summary",
              "type": "ui.table",
              "area": "main",
              "title": "Проверка агента релевантности",
              "visibleIf": "$state.aiEventAnalysisTab === 'agent'",
              "dataSource": {
                "kind": "y",
                "path": "data/ai_event_analysis/agent_summary"
              },
              "inputs": {
                "emptyText": "Запустите проверку агента, чтобы заполнить сценарий",
                "columns": [
                  {
                    "key": "name",
                    "label": "Элемент"
                  },
                  {
                    "key": "value",
                    "label": "Значение",
                    "width": "180px",
                    "mono": true
                  },
                  {
                    "key": "notes",
                    "label": "Примечания"
                  }
                ]
              }
            },
            {
              "id": "ai-event-analysis-agent-plan",
              "type": "ui.table",
              "area": "main",
              "title": "Рекомендованный план обновления",
              "visibleIf": "$state.aiEventAnalysisTab === 'agent'",
              "dataSource": {
                "kind": "y",
                "path": "data/ai_event_analysis/agent_plan"
              },
              "inputs": {
                "emptyText": "План агента отсутствует",
                "columns": [
                  {
                    "key": "projection_key",
                    "label": "Проекция"
                  },
                  {
                    "key": "demanded",
                    "label": "Востребована",
                    "width": "100px"
                  },
                  {
                    "key": "score",
                    "label": "Оценка",
                    "width": "90px",
                    "mono": true
                  },
                  {
                    "key": "agent_action",
                    "label": "Действие агента",
                    "width": "130px"
                  },
                  {
                    "key": "rule_action",
                    "label": "Действие правила",
                    "width": "130px"
                  },
                  {
                    "key": "comparison",
                    "label": "Сравнение",
                    "width": "150px"
                  }
                ]
              }
            },
            {
              "id": "ai-event-analysis-agent-gates",
              "type": "ui.table",
              "area": "main",
              "title": "Ограничения безопасности агента",
              "visibleIf": "$state.aiEventAnalysisTab === 'agent'",
              "dataSource": {
                "kind": "y",
                "path": "data/ai_event_analysis/agent_gates"
              },
              "inputs": {
                "emptyText": "Результаты проверки безопасности отсутствуют",
                "columns": [
                  {
                    "key": "gate",
                    "label": "Проверка"
                  },
                  {
                    "key": "value",
                    "label": "Значение",
                    "width": "100px",
                    "mono": true
                  },
                  {
                    "key": "target",
                    "label": "Цель",
                    "width": "100px"
                  },
                  {
                    "key": "status",
                    "label": "Состояние",
                    "width": "100px"
                  },
                  {
                    "key": "notes",
                    "label": "Примечания"
                  }
                ]
              }
            },
            {
              "id": "ai-event-analysis-subscription-summary",
              "type": "ui.table",
              "area": "main",
              "title": "Сводка потока подписок",
              "visibleIf": "$state.aiEventAnalysisTab === 'subscriptions'",
              "dataSource": {
                "kind": "y",
                "path": "data/ai_event_analysis/subscription_summary"
              },
              "inputs": {
                "emptyText": "Сводка подписок отсутствует",
                "columns": [
                  {
                    "key": "name",
                    "label": "Метрика"
                  },
                  {
                    "key": "value",
                    "label": "Значение",
                    "width": "110px",
                    "mono": true
                  }
                ]
              }
            },
            {
              "id": "ai-event-analysis-subscription-edges",
              "type": "ui.table",
              "area": "main",
              "title": "Связи издателей и подписчиков",
              "visibleIf": "$state.aiEventAnalysisTab === 'subscriptions'",
              "dataSource": {
                "kind": "y",
                "path": "data/ai_event_analysis/subscription_edges"
              },
              "inputs": {
                "emptyText": "Данные потока подписок отсутствуют",
                "columns": [
                  {
                    "key": "event_type",
                    "label": "Событие"
                  },
                  {
                    "key": "publisher",
                    "label": "Источник",
                    "width": "130px"
                  },
                  {
                    "key": "subscriber",
                    "label": "Потребитель",
                    "width": "170px"
                  },
                  {
                    "key": "events",
                    "label": "События",
                    "width": "80px",
                    "mono": true
                  },
                  {
                    "key": "fanout",
                    "label": "Рассылка",
                    "width": "80px",
                    "mono": true
                  },
                  {
                    "key": "state",
                    "label": "Состояние",
                    "width": "130px"
                  }
                ]
              }
            },
            {
              "id": "ai-event-analysis-chart",
              "type": "visual.metricChart",
              "area": "right",
              "title": "Готовность анализа",
              "visibleIf": "$state.aiEventAnalysisTab === 'overview' || $state.aiEventAnalysisTab === 'metrics'",
              "dataSource": {
                "kind": "y",
                "path": "data/ai_event_analysis/chart"
              },
              "inputs": {
                "xKey": "ts",
                "yKey": "value",
                "emptyText": "Данные графика отсутствуют"
              }
            },
            {
              "id": "ai-event-analysis-volume-chart",
              "type": "visual.metricChart",
              "area": "right",
              "title": "Объём событий",
              "visibleIf": "$state.aiEventAnalysisTab === 'windows' || $state.aiEventAnalysisTab === 'dataset'",
              "dataSource": {
                "kind": "y",
                "path": "data/ai_event_analysis/event_volume_chart"
              },
              "inputs": {
                "xKey": "ts",
                "yKey": "value",
                "emptyText": "Данные объёма событий отсутствуют"
              }
            },
            {
              "id": "ai-event-analysis-class-chart",
              "type": "visual.metricChart",
              "area": "right",
              "title": "Распределение классов",
              "visibleIf": "$state.aiEventAnalysisTab === 'windows' || $state.aiEventAnalysisTab === 'metrics'",
              "dataSource": {
                "kind": "y",
                "path": "data/ai_event_analysis/class_distribution_chart"
              },
              "inputs": {
                "xKey": "ts",
                "yKey": "value",
                "emptyText": "Данные распределения классов отсутствуют"
              }
            },
            {
              "id": "ai-event-analysis-subscription-chart",
              "type": "visual.metricChart",
              "area": "right",
              "title": "Объём типов событий",
              "visibleIf": "$state.aiEventAnalysisTab === 'subscriptions'",
              "dataSource": {
                "kind": "y",
                "path": "data/ai_event_analysis/subscription_chart"
              },
              "inputs": {
                "xKey": "ts",
                "yKey": "value",
                "emptyText": "График подписок отсутствует"
              }
            },
            {
              "id": "ai-event-analysis-actions",
              "type": "input.commandBar",
              "area": "right",
              "title": "Действия",
              "inputs": {
                "variant": "stack",
                "size": "small",
                "buttons": [
                  {
                    "id": "run_demo",
                    "label": "Запустить демо-оценку"
                  },
                  {
                    "id": "run_trials",
                    "label": "Запустить синтетическую проверку"
                  },
                  {
                    "id": "run_real_trial",
                    "label": "Запустить проверку на логах"
                  },
                  {
                    "id": "run_agent_trial",
                    "label": "Проверить агента"
                  },
                  {
                    "id": "refresh_snapshot",
                    "label": "Обновить демо"
                  },
                  {
                    "id": "analyze_logs",
                    "label": "Проанализировать логи"
                  },
                  {
                    "id": "analyze_health",
                    "label": "Проверить состояние"
                  },
                  {
                    "id": "analyze_subscriptions",
                    "label": "Проверить подписки"
                  },
                  {
                    "id": "build_windows",
                    "label": "Построить окна"
                  },
                  {
                    "id": "export_jsonl",
                    "label": "Экспорт JSONL"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:run_demo",
                  "type": "callSkill",
                  "target": "ai_event_analysis_skill.run_demo_evaluation",
                  "params": {
                    "webspace_id": "$runtime.webspace_id"
                  }
                },
                {
                  "on": "click:run_trials",
                  "type": "callSkill",
                  "target": "ai_event_analysis_skill.run_trial_suite",
                  "params": {
                    "webspace_id": "$runtime.webspace_id"
                  }
                },
                {
                  "on": "click:run_real_trial",
                  "type": "callSkill",
                  "target": "ai_event_analysis_skill.run_real_trial",
                  "params": {
                    "webspace_id": "$runtime.webspace_id",
                    "event_count": 14,
                    "window_seconds": 60,
                    "max_lines": 600
                  }
                },
                {
                  "on": "click:run_agent_trial",
                  "type": "callSkill",
                  "target": "ai_event_analysis_skill.run_projection_relevance_agent_trial",
                  "params": {
                    "webspace_id": "$runtime.webspace_id",
                    "event_type": "core.update.status",
                    "threshold": 0.5
                  }
                },
                {
                  "on": "click:refresh_snapshot",
                  "type": "callSkill",
                  "target": "ai_event_analysis_skill.refresh_snapshot",
                  "params": {
                    "webspace_id": "$runtime.webspace_id"
                  }
                },
                {
                  "on": "click:analyze_logs",
                  "type": "callSkill",
                  "target": "ai_event_analysis_skill.analyze_local_logs",
                  "params": {
                    "webspace_id": "$runtime.webspace_id",
                    "window_seconds": 60
                  }
                },
                {
                  "on": "click:analyze_health",
                  "type": "callSkill",
                  "target": "ai_event_analysis_skill.analyze_observability_health",
                  "params": {
                    "webspace_id": "$runtime.webspace_id",
                    "window_seconds": 60,
                    "max_lines": 800
                  }
                },
                {
                  "on": "click:analyze_subscriptions",
                  "type": "callSkill",
                  "target": "ai_event_analysis_skill.analyze_subscription_flow",
                  "params": {
                    "webspace_id": "$runtime.webspace_id"
                  }
                },
                {
                  "on": "click:build_windows",
                  "type": "callSkill",
                  "target": "ai_event_analysis_skill.build_event_windows",
                  "params": {
                    "webspace_id": "$runtime.webspace_id",
                    "window_seconds": 60
                  }
                },
                {
                  "on": "click:export_jsonl",
                  "type": "callSkill",
                  "target": "ai_event_analysis_skill.export_event_windows_jsonl",
                  "params": {
                    "webspace_id": "$runtime.webspace_id"
                  }
                }
              ]
            },
            {
              "id": "ai-event-analysis-results",
              "type": "ui.list",
              "area": "bottom",
              "title": "Ход проверки",
              "dataSource": {
                "kind": "stream",
                "receiver": "ai_event_analysis.results"
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "description",
                "detailsPath": "content",
                "showDetails": false,
                "itemAccordion": false,
                "detailsModal": true,
                "detailsModalTitleKey": "title",
                "emptyText": "Результатов проверки пока нет"
              }
            }
          ]
        }
      }
    },
    "widgets": {}
  },
  "ydoc_defaults": {
    "data/ai_event_analysis": {
      "summary": {
        "label": "Интеллектуальный анализ событий",
        "value": "0.000",
        "subtitle": "Macro-F1 правиловой основы",
        "description": "Проверяемая задача интеллектуального анализа операционных событий AdaOS.",
        "buttons": [
          {
            "id": "open",
            "label": "Открыть"
          },
          {
            "id": "run_demo",
            "label": "Запустить демо-проверку"
          }
        ]
      },
      "task": [
        {
          "id": "objective",
          "title": "Цель",
          "description": "Разделить окна событий на нормальные и проблемные, а также показать главные признаки решения."
        },
        {
          "id": "baseline",
          "title": "Правиловая основа",
          "description": "Сравнивать будущие модели с повторяемым правиловым классификатором."
        },
        {
